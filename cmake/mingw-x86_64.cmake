# A normal installed MinGW toolchain, or one extracted into EDGEECHO_MINGW_ROOT.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(DEFINED ENV{EDGEECHO_MINGW_ROOT})
    file(TO_CMAKE_PATH "$ENV{EDGEECHO_MINGW_ROOT}" mingw_root)
    set(CMAKE_C_COMPILER "${mingw_root}/usr/bin/x86_64-w64-mingw32-gcc-posix")
    set(CMAKE_CXX_COMPILER "${mingw_root}/usr/bin/x86_64-w64-mingw32-g++-posix")
    set(CMAKE_RC_COMPILER "${mingw_root}/usr/bin/x86_64-w64-mingw32-windres")
    set(CMAKE_FIND_ROOT_PATH "${mingw_root}/usr/x86_64-w64-mingw32")
else()
    set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc-posix)
    set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++-posix)
    set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
